<style>
  .sidebar {
    width: 280px;
    height: 100%;
    background: #121214;
    color: #ededef;
    flex-shrink: 0;
    overflow-y: auto; /* Allows sidebar to scroll if links overflow */
    box-sizing: border-box;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .sidebar-header h2 {
    margin: 0 0 2rem 0;
    font-size: 1.25rem;
    letter-spacing: -0.025em;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .nav-links a {
    color: #94949b;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
  }

  .nav-bottom {
    margin-top: auto; /* Pushes the container to the absolute bottom of the sidebar */
    display: flex;
  }

  .nav-bottom a {
    color: #94949b;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    padding: auto auto auto auto;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
  }

  .nav-links a:hover,
  .nav-bottom a:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
  }

</style>
